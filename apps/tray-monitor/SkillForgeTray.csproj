<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>SkillForgeTray</RootNamespace>
    <AssemblyName>SkillForgeTray</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models\IpcMessages.cs" />
    <Compile Include="Services\IpcClientService.cs" />
    <Compile Include="Services\LogBufferService.cs" />
    <Compile Include="UI\TrayApplicationContext.cs" />
    <Compile Include="UI\LogViewerForm.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
